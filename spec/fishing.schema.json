        "steer": {
          "type": "number",
          "default": 0
        }
      },
      "required": []
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/State"
        },
        "events": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "enum": [
              "cast",
              "bite",
              "hooked",
              "rest",
              "warning",
              "surge",
              "caught",
              "escaped"
            ]
          }
        }
      },
      "required": [
        "state",
        "events"
      ]
    },
    "Fish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1.6
        },
        "fishSpeed": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.65
        },
        "surge": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "rest": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 3
        },
        "fatigue": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 0.25
        },
        "recovery": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.4
        },
        "biteWindow": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "targetCenter": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.8
        },
        "targetSpread": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1
        },
        "restWander": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 0.3
        },
        "preference": {
          "type": "string",
          "maxLength": 64
        },
        "pondWeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "strength",
        "fishSpeed",
        "surge",
        "rest",
        "fatigue",
        "recovery",
        "biteWindow",
        "targetCenter",
        "targetSpread",
        "restWander",
        "preference",
        "pondWeight"
      ]
    },
    "Rod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowSize": {
          "type": "number",
          "minimum": 0.12,
          "maximum": 0.45
        },
        "reelRate": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.2
        },
        "lineCapacity": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "tackleAcceleration": {
          "type": "number",
          "minimum": 1.8,
          "maximum": 5
        },
        "tackleDamping": {
          "type": "number",
          "minimum": 2.5,
          "maximum": 6
        },
        "tackleSpeed": {
          "type": "number",
          "minimum": 0.55,
          "maximum": 1.1
        }
      },
      "required": [
        "windowSize",
        "reelRate",
        "lineCapacity",
        "tackleAcceleration",
        "tackleDamping",
        "tackleSpeed"
      ]
    },
    "Bait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attraction": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "biteBonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "affinity": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5
          }
        }
      },
      "required": [
        "attraction",
        "biteBonus",
        "affinity"
      ]
    },
    "Loadout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fish": {
          "$ref": "#/$defs/Fish"
        },
        "rod": {
          "$ref": "#/$defs/Rod"
        },
        "bait": {
          "$ref": "#/$defs/Bait"
        }
      },
      "required": [
        "fish",
        "rod",
        "bait"
      ]
    },
    "Encounter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "config": {
          "$ref": "#/$defs/Config"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "notes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "version",
        "config",
        "seed",
        "notes"
      ]
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "odds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "index",
        "seed",
        "odds"
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "type": "number"
        },
        "pull": {
          "type": "number"
        },
        "targetTension": {
          "type": "number"
        },
        "progressRate": {
          "type": "number"
        },
        "tensionRate": {
          "type": "number"
        },
        "energyRate": {
          "type": "number"
        },
        "alignmentX": {
          "type": "number"
        },
        "alignmentY": {
          "type": "number"
        }
      },
      "required": [
        "alignment",
        "pull",
        "targetTension",
        "progressRate",
        "tensionRate",
        "energyRate",
        "alignmentX",
        "alignmentY"
      ]
    }
  }
}
