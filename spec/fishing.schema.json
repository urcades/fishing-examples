{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fishing Protocol draft 0.1",
  "description": "Named wire types. Semantic checks in PROTOCOL.md are also required. Resolve a specific $defs entry; the root does not validate an arbitrary message.",
  "$defs": {
    "Parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1.6,
          "default": 1
        },
        "surge": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3,
          "default": 1.8
        },
        "rest": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 3,
          "default": 1.2
        },
        "fatigue": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 0.25,
          "default": 0.1
        },
        "reelRate": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.2,
          "default": 0.08
        },
        "escapeRate": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.2,
          "default": 0.08
        },
        "baseTension": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.5,
          "default": 0.3
        },
        "response": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2,
          "default": 0.8
        },
        "recovery": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.4,
          "default": 0.2
        },
        "warning": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1,
          "default": 0.5
        },
        "biteWindow": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1.1
        },
        "jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "default": 0.15
        },
        "fishSpeed": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.65,
          "default": 0.34
        },
        "windowSize": {
          "type": "number",
          "minimum": 0.12,
          "maximum": 0.45,
          "default": 0.28
        },
        "lineCapacity": {
          "type": "number",
          "minimum": 1,
          "maximum": 2,
          "default": 1
        },
        "tackleAcceleration": {
          "type": "number",
          "minimum": 1.8,
          "maximum": 5,
          "default": 3.2
        },
        "tackleDamping": {
          "type": "number",
          "minimum": 2.5,
          "maximum": 6,
          "default": 3.8
        },
        "tackleSpeed": {
          "type": "number",
          "minimum": 0.55,
          "maximum": 1.1,
          "default": 0.9
        },
        "waitMin": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 5,
          "default": 1.5
        },
        "waitMax": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 8,
          "default": 3
        },
        "targetCenter": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.8,
          "default": 0.5
        },
        "targetSpread": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1,
          "default": 1
        },
        "restWander": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 0.3,
          "default": 0.16
        }
      },
      "required": []
    },
    "Point": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Capture": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rectangle"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "polygon"
            },
            "rings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 48,
                "items": {
                  "$ref": "#/$defs/Point"
                }
              }
            }
          },
          "required": [
            "kind",
            "rings"
          ]
        }
      ]
    },
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "hook",
            "pressure",
            "tracking"
          ]
        },
        "dimensions": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "capture": {
          "$ref": "#/$defs/Capture"
        }
      },
      "required": [
        "mode",
        "dimensions",
        "capture"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "tracking"
              }
            }
          },
          "then": {
            "properties": {
              "dimensions": {
                "enum": [
                  1,
                  2
                ]
              }
            }
          },
          "else": {
            "properties": {
              "dimensions": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dimensions": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "rectangle"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        }
      ]
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "hook",
            "pressure",
            "tracking"
          ]
        },
        "dimensions": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "capture": {
          "$ref": "#/$defs/Capture"
        },
        "hookBonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0
        }
      },
      "required": [
        "mode",
        "dimensions",
        "capture"
      ]
    },
    "Motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fishPosition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fishTarget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tacklePosition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fishX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fishTargetX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tackleX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fishVelocity": {
          "type": "number",
          "minimum": -1.105,
          "maximum": 1.105
        },
        "fishVelocityX": {
          "type": "number",
          "minimum": -1.105,
          "maximum": 1.105
        },
        "tackleVelocity": {
          "type": "number",
          "minimum": -1.1,
          "maximum": 1.1
        },
        "tackleVelocityX": {
          "type": "number",
          "minimum": -1.1,
          "maximum": 1.1
        },
        "steer": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
      "required": [
        "fishPosition",
        "fishTarget",
        "tacklePosition",
        "fishX",
        "fishTargetX",
        "tackleX",
        "fishVelocity",
        "fishVelocityX",
        "tackleVelocity",
        "tackleVelocityX",
        "steer"
      ]
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "hook",
            "pressure",
            "tracking"
          ]
        },
        "dimensions": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "phase": {
          "enum": [
            "ready",
            "waiting",
            "bite",
            "struggle",
            "caught",
            "escaped"
          ]
        },
        "behavior": {
          "enum": [
            "rest",
            "warning",
            "surge"
          ]
        },
        "reason": {
          "enum": [
            null,
            "missed_bite",
            "line_broke",
            "got_away",
            "landed",
            "timeout"
          ]
        },
        "motion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Motion"
            }
          ]
        },
        "rng": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "phaseTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "behaviorTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "behaviorDuration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tension": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "primary": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "version",
        "mode",
        "dimensions",
        "phase",
        "behavior",
        "reason",
        "motion",
        "rng",
        "tick",
        "phaseTicks",
        "duration",
        "behaviorTicks",
        "behaviorDuration",
        "progress",
        "tension",
        "energy",
        "primary"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "tracking"
              }
            }
          },
          "then": {
            "properties": {
              "motion": {
                "$ref": "#/$defs/Motion"
              }
            }
          },
          "else": {
            "properties": {
              "motion": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "number",
          "default": 0
